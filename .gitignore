/*
!/.gitignore
!/README.md
!/LICENSE
!/.github/
!/findings/
!/scripts/
!/src/
# the native plug-in (moved in from virus-ti-native with its history; its own .gitignore covers build folders)
!/native/
!/.gitmodules
!/CONTRIBUTING.md
!/AGENTS.md
!/CLAUDE.md
# screenshots for the README (our own UI only: no Access artwork, no personal data)
!/docs/
/docs/*
!/docs/images/
# the repository's Claude Code skills only (a contributor's local .claude settings stay out)
!/.claude/
/.claude/*
!/.claude/skills/
__pycache__/
*.pyc
