<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.derpsn.tirevive.virus-control.au</string>
	<key>CFBundleName</key>
	<string>TI Revive Virus Control</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@PROJECT_VERSION@</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>NSHumanReadableCopyright</key>
	<string>TI Revive (MIT). Not affiliated with Access Music or Kemper.</string>
	<key>AudioComponents</key>
	<array>
		<dict>
			<!-- the codes of the classic TI Revive Audio Unit: its Logic / GarageBand projects open with this one -->
			<key>type</key>
			<string>aumu</string>
			<key>subtype</key>
			<string>VTIr</string>
			<key>manufacturer</key>
			<string>TIRv</string>
			<key>name</key>
			<string>TI Revive: TI Revive Virus Control</string>
			<key>description</key>
			<string>Access Virus TI Total Integration without the old drivers</string>
			<key>version</key>
			<integer>@VTI_AU_VERSION@</integer>
			<key>factoryFunction</key>
			<string>TIReviveVirusControlFactory</string>
			<key>sandboxSafe</key>
			<false/>
			<key>tags</key>
			<array>
				<string>Synthesizer</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
