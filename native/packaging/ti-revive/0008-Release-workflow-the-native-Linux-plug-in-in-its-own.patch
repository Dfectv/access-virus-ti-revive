From 93923426a56c77fd505942ed6c7f3024eb3f72a8 Mon Sep 17 00:00:00 2001
From: derpsn <callmederpsn@proton.me>
Date: Wed, 14 Oct 2026 21:51:54 +0200
Subject: [PATCH 8/8] Release workflow: the native Linux plug-in in its own job
 on Ubuntu 22.04; the Linux package job stays on 24.04 (mingw)

Rehearsal: on 22.04 the Wine-side wrapper did not build (afunix.h, WASAPI flags missing in its mingw-w64).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/build.yml    | 39 +++++++++++++++++++++++++++-------
 scripts/linux-build-release.sh |  5 ++++-
 2 files changed, 35 insertions(+), 9 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index f539a11..dbc085d 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -135,22 +135,45 @@ jobs:
           path: out/TI-Revive-*-mac.zip
           if-no-files-found: error
 
-  linux:
-    runs-on: ubuntu-22.04 # glibc 2.35: the native plug-in runs on Ubuntu 22.04 / Debian 12 and newer
+  native-linux: # the native plug-in for Linux, on Ubuntu 22.04 (glibc 2.35: runs on Ubuntu 22.04 / Debian 12 and newer)
+    runs-on: ubuntu-22.04
     steps:
       - uses: actions/checkout@v7
         with:
           submodules: recursive # native/external/vst3sdk
-      - name: Install mingw-w64 and the native plug-in's build dependencies
+      - name: Build dependencies
         run: |
-          sudo apt-get update && sudo apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 make curl bzip2 \
-            g++ ninja-build libx11-dev libxcb1-dev libxcb-util-dev libxcb-cursor-dev libxcb-xkb-dev libxcb-keysyms1-dev \
-            libxkbcommon-dev libxkbcommon-x11-dev libfontconfig1-dev libcairo2-dev libgtkmm-3.0-dev libsqlite3-dev \
-            libpango1.0-dev
+          sudo apt-get update && sudo apt-get install -y --no-install-recommends g++ make ninja-build libx11-dev \
+            libxcb1-dev libxcb-util-dev libxcb-cursor-dev libxcb-xkb-dev libxcb-keysyms1-dev libxkbcommon-dev \
+            libxkbcommon-x11-dev libfontconfig1-dev libcairo2-dev libgtkmm-3.0-dev libsqlite3-dev libpango1.0-dev
           pip3 install --user "cmake>=3.25" # Ubuntu 22.04 ships 3.22
           echo "$HOME/.local/bin" >> "$GITHUB_PATH"
       - name: Build
-        run: bash scripts/linux-build-release.sh "$PWD" "${GITHUB_REF_NAME#v}" "$PWD/out"
+        run: |
+          cmake -S native -B native-build -G Ninja -DCMAKE_BUILD_TYPE=Release
+          cmake --build native-build --target VirusTINative vtitests
+          strip "native-build/VST3/Release/TI Revive Virus Control.vst3/Contents/x86_64-linux/TI Revive Virus Control.so"
+      - name: Unit tests
+        run: ctest --test-dir native-build --output-on-failure
+      - uses: actions/upload-artifact@v7
+        with:
+          name: native-linux
+          path: native-build/VST3/Release/TI Revive Virus Control.vst3
+          if-no-files-found: error
+
+  linux:
+    needs: native-linux
+    runs-on: ubuntu-24.04 # the Wine-side tools need its newer mingw-w64
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/download-artifact@v8
+        with:
+          name: native-linux
+          path: native-linux/TI Revive Virus Control.vst3
+      - name: Install mingw-w64
+        run: sudo apt-get update && sudo apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 make curl bzip2
+      - name: Build
+        run: NATIVE_PREBUILT="$PWD/native-linux/TI Revive Virus Control.vst3" bash scripts/linux-build-release.sh "$PWD" "${GITHUB_REF_NAME#v}" "$PWD/out"
       - uses: actions/upload-artifact@v7
         with:
           name: TI-Revive-linux
diff --git a/scripts/linux-build-release.sh b/scripts/linux-build-release.sh
index ceb195c..bf0135f 100755
--- a/scripts/linux-build-release.sh
+++ b/scripts/linux-build-release.sh
@@ -36,7 +36,10 @@ x86_64-w64-mingw32-gcc -O2 -Wall -Wextra -DVTIEMU_NO_DLLMAIN -DVTIEMU_VIRTUAL_DE
 x86_64-w64-mingw32-gcc -O2 -Wall -o "$BUILD/vtimsipatch.exe" "$REPO/src/installer-linux/vtimsipatch.c" -lmsi -static
 
 NATIVE=""
-if [ -f "$REPO/native/CMakeLists.txt" ]; then # the native plug-in "TI Revive Virus Control" (native/, Linux VST3)
+if [ -n "${NATIVE_PREBUILT:-}" ]; then # built elsewhere (the release workflow builds it on an older Ubuntu, glibc)
+    NATIVE="$NATIVE_PREBUILT"
+    [ -f "$NATIVE/Contents/x86_64-linux/TI Revive Virus Control.so" ] || { echo "no native plug-in in $NATIVE"; exit 1; }
+elif [ -f "$REPO/native/CMakeLists.txt" ]; then # the native plug-in "TI Revive Virus Control" (native/, Linux VST3)
     echo "== native plug-in"
     cmake -S "$REPO/native" -B "$BUILD/native" -DCMAKE_BUILD_TYPE=Release >/dev/null
     cmake --build "$BUILD/native" --target VirusTINative -j4 >/dev/null
-- 
2.53.0

