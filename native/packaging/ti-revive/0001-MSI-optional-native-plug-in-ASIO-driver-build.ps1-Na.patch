From 2d6f92f05f1f78d6ae77c5de1cac64e8e57ffe68 Mon Sep 17 00:00:00 2001
From: derpsn <callmederpsn@proton.me>
Date: Wed, 14 Oct 2026 20:07:11 +0200
Subject: [PATCH 1/5] MSI: optional native plug-in + ASIO driver (build.ps1
 -NativeBin, native/packaging/windows/native.wxs)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/installer/TIRevive.wxs |  4 ++++
 src/installer/build.ps1    | 13 ++++++++++---
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/installer/TIRevive.wxs b/src/installer/TIRevive.wxs
index 8837ff7..5743759 100644
--- a/src/installer/TIRevive.wxs
+++ b/src/installer/TIRevive.wxs
@@ -72,6 +72,10 @@
       <ComponentGroupRef Id="Core" />
       <ComponentGroupRef Id="Plugin" />
       <ComponentGroupRef Id="Menu" />
+<?if $(var.Native) = "1" ?>
+      <!-- the native plug-in "TI Revive Virus Control" + ASIO driver "TI Revive Virus Audio" (native/packaging/windows/native.wxs) -->
+      <ComponentGroupRef Id="Native" />
+<?endif?>
     </Feature>
 
     <!-- driver package + trusted cert (deferred, SYSTEM), and the reverse on uninstall -->
diff --git a/src/installer/build.ps1 b/src/installer/build.ps1
index 06c31f2..546784c 100644
--- a/src/installer/build.ps1
+++ b/src/installer/build.ps1
@@ -6,7 +6,8 @@
 # Used by the GitHub workflow (.github/workflows/build.yml) and by scripts/win11/build-msi.sh (build VM, where
 # .NET and WiX live in C:\build\dotnet and C:\build\wix).
 param([string]$Root = 'C:\build\tirevive', [string]$Bin, [string]$Src, [string]$Out, [string]$Version = '0.1.1',
-      [switch]$Bundle) # -Bundle: also TI Revive setup.exe around the MSI (TIReviveSetup.wxs, needs WixToolset.BootstrapperApplications.wixext)
+      [switch]$Bundle,
+      [string]$NativeBin) # -NativeBin: folder with "TI Revive Virus Control.vst3\" + VirusTINative_ASIO.dll (native plug-in) # -Bundle: also TI Revive setup.exe around the MSI (TIReviveSetup.wxs, needs WixToolset.BootstrapperApplications.wixext)
 $ErrorActionPreference = 'Stop'
 if (-not $Bin) { $Bin = Join-Path $Root 'bin' }
 if (-not $Src) { $Src = Join-Path $Root 'src' }
@@ -17,9 +18,15 @@ if (Test-Path 'C:\build\dotnet') { # build VM layout
 }
 $env:DOTNET_CLI_TELEMETRY_OPTOUT = '1'
 New-Item -ItemType Directory -Force $Out | Out-Null
-wix build (Join-Path $Src 'installer\TIRevive.wxs') -arch x64 `
+$sources = @(Join-Path $Src 'installer\TIRevive.wxs')
+$native = '0'
+if ($NativeBin) { # native/packaging/windows/native.wxs next to src\ (repository layout)
+    $sources += Join-Path (Split-Path $Src -Parent) 'native\packaging\windows\native.wxs'
+    $native = '1'
+}
+wix build @sources -arch x64 `
     -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext `
-    -d "Bin=$Bin" -d "Src=$Src" -d "Version=$Version" `
+    -d "Bin=$Bin" -d "Src=$Src" -d "Version=$Version" -d "Native=$native" -d "NativeBin=$NativeBin" `
     -o (Join-Path $Out 'TI Revive.msi')
 if ($LASTEXITCODE) { throw "wix build failed ($LASTEXITCODE)" }
 Get-Item (Join-Path $Out 'TI Revive.msi') | Select-Object Name, Length
-- 
