From cec7a89ef6b7e377c5c18235d4effa4c15b059f3 Mon Sep 17 00:00:00 2001
From: derpsn <callmederpsn@proton.me>
Date: Thu, 15 Oct 2026 06:43:04 +0200
Subject: [PATCH 12/13] Mac 0.8.0: no bridge VST3 (the native plug-in has its
 class id); the Audio Unit stays; README-mac

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/mac-build-release.sh          |  3 ++-
 src/installer-mac/README-mac.txt      | 10 +++++++---
 src/installer-mac/scripts/postinstall |  2 ++
 3 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/scripts/mac-build-release.sh b/scripts/mac-build-release.sh
index 91751ce..cf450b8 100755
--- a/scripts/mac-build-release.sh
+++ b/scripts/mac-build-release.sh
@@ -51,7 +51,8 @@ ROOT="$BUILD/root"
 SUP="$ROOT/Library/Application Support"
 mkdir -p "$ROOT/Library/Audio/Plug-Ins/VST3" "$ROOT/Library/Audio/Plug-Ins/Components" "$SUP/TI Revive" \
     "$SUP/Access Music/Virus TI/Common"
-cp -R "$BUILD/Virus TI (TI Revive).vst3" "$ROOT/Library/Audio/Plug-Ins/VST3/"
+# 0.8.0: no bridge VST3 - "TI Revive Virus Control" (native) has its class id and opens its projects; the bridge's
+# Audio Unit stays (Logic / GarageBand)
 cp -R "$BUILD/Virus TI (TI Revive).component" "$ROOT/Library/Audio/Plug-Ins/Components/"
 [ -n "$NATIVE" ] && cp -R "$NATIVE" "$ROOT/Library/Audio/Plug-Ins/VST3/"
 cp "$BUILD/mac/vtibroker" "$SUP/TI Revive/vtibroker"
diff --git a/src/installer-mac/README-mac.txt b/src/installer-mac/README-mac.txt
index 8e704e6..55922e4 100644
--- a/src/installer-mac/README-mac.txt
+++ b/src/installer-mac/README-mac.txt
@@ -18,12 +18,16 @@ Install
 3. Connect the Virus TI by USB. Start your DAW and allow it to use the microphone when macOS asks
    (System Settings > Privacy & Security > Microphone): macOS only gives the Virus' audio to apps with that
    permission; without it the plug-in stays silent.
-4. Rescan plug-ins and use "Virus TI (TI Revive)" (vendor "TI Revive"). The first start of a session takes a few
-   seconds (the original plug-in starts in a helper under Rosetta).
+4. Rescan plug-ins and use the VST3 "TI Revive Virus Control" (vendor "TI Revive"): a native plug-in (Apple Silicon
+   and Intel) that looks and works like the original Virus Control, no Rosetta needed. Projects saved with the
+   VST3 "Virus TI (TI Revive)" of earlier versions open with it. Logic Pro / GarageBand: the Audio Unit
+   "Virus TI (TI Revive)" (runs the original plug-in under Rosetta, see below).
 
 How it works
+"TI Revive Virus Control" reads the skin, the parameter descriptions and the ROM banks from your Access
+installation and talks to the Virus through TI Revive's broker. The Audio Unit for Logic works the old way:
 The original Access plug-in is Intel-only and needs the Access kernel driver, which cannot load on Apple Silicon.
-"Virus TI (TI Revive)" is a native plug-in that runs the original in a helper process under Rosetta and shows its
+the Audio Unit "Virus TI (TI Revive)" runs the original in a helper process under Rosetta and shows its
 editor in your DAW. A small background service (vtibroker, started on demand by the plug-in, ends 30 s after the
 last use) talks to the Virus over USB, and TI Revive's own libVirusUSB.dylib takes the place of Access' driver
 library. Audio comes from macOS' built-in USB
diff --git a/src/installer-mac/scripts/postinstall b/src/installer-mac/scripts/postinstall
index 6161302..3e7a0bb 100755
--- a/src/installer-mac/scripts/postinstall
+++ b/src/installer-mac/scripts/postinstall
@@ -17,5 +17,7 @@ fi
 rm -f /Library/LaunchAgents/io.github.derpsn.tirevive.vtibroker.plist
 # a running broker is NOT stopped: it serves its current session to the end and exits 30 s after its last client;
 # the next start picks up the new binary (stopping it cut off a running DAW session, E112)
+# 0.8.0: the bridge VST3 "Virus TI (TI Revive)" is replaced by "TI Revive Virus Control" (same class id)
+rm -rf "/Library/Audio/Plug-Ins/VST3/Virus TI (TI Revive).vst3"
 killall -9 AudioComponentRegistrar 2>/dev/null || true # make macOS rescan Audio Units (the new component)
 exit 0
-- 
2.53.0

