+    if (-not $Msi -and -not $Quiet) {
+        Add-Type -AssemblyName System.Windows.Forms
+        $dlg = New-Object System.Windows.Forms.OpenFileDialog
+        $dlg.Title = 'Select the Access "Virus TI Software Suite" installer (64-bit .msi)'
