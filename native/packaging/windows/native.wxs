<!-- native.wxs - the native plug-in and its ASIO driver in TI Revive's MSI (WiX 5 fragment).
     TIRevive.wxs references the group: <ComponentGroupRef Id="Native" /> in Feature "Main"; build.ps1 passes
     -d NativeBin=<folder with "TI Revive Virus Control.vst3\" and VirusTINative_ASIO.dll>.
     Directories INSTALLFOLDER (Program Files\TI Revive) and VST3FOLDER (Common Files\VST3) come from TIRevive.wxs. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <DirectoryRef Id="VST3FOLDER">
      <Directory Id="NATIVEBUNDLE" Name="TI Revive Virus Control.vst3">
        <Directory Id="NATIVECONTENTS" Name="Contents">
          <Directory Id="NATIVEBIN" Name="x86_64-win" />
          <Directory Id="NATIVERES" Name="Resources" />
        </Directory>
      </Directory>
    </DirectoryRef>

    <ComponentGroup Id="Native">
      <!-- the VST3 bundle "TI Revive Virus Control" (vendor TI Revive) -->
      <Component Directory="NATIVEBIN">
        <File Id="nativevst3" Source="$(var.NativeBin)\TI Revive Virus Control.vst3\Contents\x86_64-win\TI Revive Virus Control.vst3" />
      </Component>
      <Component Directory="NATIVERES">
        <File Id="nativemoduleinfo" Source="$(var.NativeBin)\TI Revive Virus Control.vst3\Contents\Resources\moduleinfo.json" />
      </Component>
      <Component Directory="NATIVEBUNDLE">
        <File Id="nativeicon" Source="$(var.NativeBin)\TI Revive Virus Control.vst3\PlugIn.ico" />
        <File Id="nativedesktopini" Source="$(var.NativeBin)\TI Revive Virus Control.vst3\desktop.ini" />
      </Component>

      <!-- ASIO driver "TI Revive Virus Audio": the Virus as a sound card through the broker (asio/asiodriver.cpp).
           Registered like DllRegisterServer does, as MSI registry values (removed on uninstall). -->
      <Component Directory="INSTALLFOLDER">
        <File Id="nativeasio" Source="$(var.NativeBin)\VirusTINative_ASIO.dll" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{F1DA6F3F-7A48-49A9-97F8-C3A8C008EABD}" Type="string"
                       Value="TI Revive Virus Audio ASIO driver" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{F1DA6F3F-7A48-49A9-97F8-C3A8C008EABD}\InprocServer32"
                       Type="string" Value="[#nativeasio]" />
        <RegistryValue Root="HKLM" Key="Software\Classes\CLSID\{F1DA6F3F-7A48-49A9-97F8-C3A8C008EABD}\InprocServer32"
                       Name="ThreadingModel" Type="string" Value="Apartment" />
        <RegistryValue Root="HKLM" Key="Software\ASIO\TI Revive Virus Audio" Name="CLSID" Type="string"
                       Value="{F1DA6F3F-7A48-49A9-97F8-C3A8C008EABD}" />
        <RegistryValue Root="HKLM" Key="Software\ASIO\TI Revive Virus Audio" Name="Description" Type="string"
                       Value="TI Revive Virus Audio" />
        <!-- the test builds' entry (same CLSID) would show the device twice -->
        <RemoveRegistryKey Root="HKLM" Key="Software\ASIO\Virus TI (native)" Action="removeOnInstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
