#!/bin/bash
# TI Revive .pkg postinstall (runs as root). The broker needs no LaunchAgent: TI Revive's libVirusUSB.dylib starts
# /Library/Application Support/TI Revive/vtibroker on demand from the DAW. Remove agents of earlier setups (the
# development agent from scripts/mac-install-broker.sh, the system agent of a 0.5.0 test build).
USER_NAME=$(stat -f %Su /dev/console)
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != root ]; then
    USER_ID=$(id -u "$USER_NAME")
    for label in com.tirevive.vtibroker io.github.derpsn.tirevive.vtibroker; do
        launchctl bootout "gui/$USER_ID/$label" 2>/dev/null || true
    done
    rm -f "/Users/$USER_NAME/Library/LaunchAgents/com.tirevive.vtibroker.plist"
fi
rm -f /Library/LaunchAgents/io.github.derpsn.tirevive.vtibroker.plist
# a running broker is NOT stopped: it serves its current session to the end and exits 30 s after its last client;
# the next start picks up the new binary (stopping it cut off a running DAW session, E112)
killall -9 AudioComponentRegistrar 2>/dev/null || true # make macOS rescan Audio Units (the new component)
exit 0
