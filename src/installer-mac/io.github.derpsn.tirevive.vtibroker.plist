<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TI Revive broker (findings/design-macos.md): started on demand by launchd socket activation in every user's
     session. SecureSocketWithKey makes launchd create a private socket per session and publish its path in the
     session environment as TIREVIVE_BROKER_SOCK (like SSH_AUTH_SOCK), which TI Revive's libVirusUSB.dylib reads.
     The broker exits after 30 s without clients; launchd starts it again on the next connect. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>io.github.derpsn.tirevive.vtibroker</string>
    <key>ProgramArguments</key>
    <array><string>/Library/Application Support/TI Revive/vtibroker</string></array>
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SecureSocketWithKey</key><string>TIREVIVE_BROKER_SOCK</string>
        </dict>
    </dict>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>ProcessType</key><string>Interactive</string>
    <key>StandardErrorPath</key><string>/tmp/tirevive-vtibroker.log</string>
</dict>
</plist>
