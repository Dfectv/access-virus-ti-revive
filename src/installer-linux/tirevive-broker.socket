# TI Revive broker (Linux): systemd starts vtibroker on the first connect of a plug-in (socket activation, like the
# on-demand start on macOS and Windows); the broker exits by itself after 30 s without clients.
# Unix socket only (0600, the user's own); the TCP socket of TI Revive 0.7 (plug-in under Wine) is gone.
[Unit]
Description=TI Revive broker socket (Access Virus TI)

[Socket]
ListenStream=/tmp/vtibroker-%U.sock
SocketMode=0600

[Install]
WantedBy=sockets.target
