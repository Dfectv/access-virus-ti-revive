; vti_winusb.inf - bind the inbox, Microsoft-signed WinUSB driver to the Virus TI MIDI interfaces.
; MI_03 (EP 0x05/0x85) and MI_04 (EP 0x06/0x86), see findings/spec.md. The audio interfaces MI_00..02 are
; left to Windows (audio comes later, findings/design.md). No kernel code of our own is installed.
; The catalog (vti_winusb.cat) is generated and signed at install time (scripts/vm-winusb-install.ps1).

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
CatalogFile = vti_winusb.cat
DriverVer   = 10/10/2026,1.0.0.1
PnpLockdown = 1

[Manufacturer]
%ProviderName% = VTI, NTamd64

[VTI.NTamd64]
%MI03.Desc% = MI03_Install, USB\VID_133E&PID_0815&MI_03
%MI04.Desc% = MI04_Install, USB\VID_133E&PID_0815&MI_04

[MI03_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[MI03_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[MI03_Install.HW]
AddReg = MI03_AddReg

[MI03_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{CF293C20-F175-42AB-B2BE-A02FEC940937}"

[MI04_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[MI04_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[MI04_Install.HW]
AddReg = MI04_AddReg

[MI04_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{5B45FAF8-316B-4B94-AABF-FF442A85C5E7}"

[Strings]
ProviderName = "virus-ti-re (local)"
MI03.Desc    = "Virus TI MIDI (WinUSB, MI_03)"
MI04.Desc    = "Virus TI Remote (WinUSB, MI_04)"
